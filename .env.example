# Copiar a .env antes de ejecutar docker-compose up.
# Estos valores son de EJEMPLO y solo sirven para desarrollo local.
# Nunca se versionan credenciales reales.

# --- PostgreSQL ---
POSTGRES_USER=vsa
POSTGRES_PASSWORD=vsa_dev_password
POSTGRES_DB=catalogo

# --- API ---
# La cadena de conexión se arma en docker-compose.yml a partir de las variables
# anteriores. Si ejecutas la API fuera de Docker, define ConnectionStrings__Default
# apuntando a Host=localhost.

# --- Frontend ---
# Destino del proxy /api del servidor de desarrollo de Vite.
# Dentro de Docker: http://backend:5000
# Fuera de Docker:  http://localhost:5000
VITE_API_PROXY_TARGET=http://backend:5000
